# Plantilla de configuración. Copiar a .env y rellenar con los valores reales.
# El archivo .env NUNCA se versiona (ver .gitignore) y NUNCA se sirve por HTTP
# (ver la regla <FilesMatch "^\.env"> del .htaccess de la raíz).

DB_HOST=localhost
DB_PORT=3306
